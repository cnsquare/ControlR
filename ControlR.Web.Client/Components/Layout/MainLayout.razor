@inherits BaseLayout
@inject ILazyInjector<IHubConnector> HubConnector

<div class="@ThemeClass">
  <ControlRLayoutProvider CurrentPalette="@CurrentPalette" @bind-IsDarkMode="@IsDarkMode" CustomTheme="@CustomTheme">

    @if (IsMainUiDisabled)
    {
      <NotFound HideActionButtons="true" />
    }
    else
    {
      <MudLayout>
        <MudAppBar Elevation="1">

          @if (RendererInfo.IsInteractive)
          {
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="@(_ => ToggleNavDrawer())" />
          }
          else
          {
            <MudStaticNavDrawerToggle DrawerId="nav-drawer" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                                      Edge="Edge.Start" />
          }

          <MudLink Href="/" Underline="Underline.None" Class="d-flex">
            <MudImage Src=@Assets["static/appicon-192.png"] Height="30" Class="mx-2" />
            <MudText Typo="Typo.h6" Color="Color.Primary">
              @(BrandingConstants.BrandName)
            </MudText>
          </MudLink>

          <MudSpacer />

          @if (RendererInfo.IsInteractive)
          {
            <ConnectionIndicator THub="@IViewerHub" />
          }

          @if (RendererInfo.IsInteractive && IsAuthenticated)
          {
            <ThemeToggle OnThemeChanged="HandleThemeChanged" />
          }

          @if (!BrandingConstants.HideSponsorshipInfo)
          {
            <MudTooltip Text="GitHub">
              <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit"
                            Href="https://github.com/bitbound/controlr/" Target="_blank" />
            </MudTooltip>
          }
        </MudAppBar>
        <MudDrawer @bind-Open="DrawerOpen" id="nav-drawer" ClipMode="DrawerClipMode.Always" Elevation="2">
          <NavMenu />
        </MudDrawer>
        <MudMainContent Class="mt-16 pa-4">
          @if (RendererInfo.IsInteractive)
          {
            <ServerAlertDisplay Class="mb-4" />

            @if (_isServerDecommissioned)
            {
              <MudAlert Severity="Severity.Error" Class="mb-4" Icon="@(Icons.Material.Filled.Dangerous)">
                <strong>Server Decommission Mode is active.</strong> When agents connect, they will automatically uninstall
                themselves.
              </MudAlert>
            }
          }

          @if (!RendererInfo.IsInteractive && IsInteractiveRoutingPage)
          {
            <div class="w-100 text-center mt-8">
              <div class="loading-progress-container">
                <MudText Typo="Typo.h4" Color="Color.Info" GutterBottom>
                  Loading <span class="loading-progress-text"></span>
                </MudText>
                <MudProgressCircular Min="0" Max="1" Indeterminate Color="Color.Info" Size="Size.Large" />
              </div>
            </div>
          }
          else
          {
            @Body
          }
        </MudMainContent>
      </MudLayout>

      @if (RendererInfo.IsInteractive)
      {
        <DeviceContentHarness />
      }
    }
  </ControlRLayoutProvider>
</div>

<div id="blazor-error-ui">
  An unhandled error has occurred.
  <a href="" class="reload">Reload</a>
  <a class="dismiss">🗙</a>
</div>

@code {
  private bool _isServerDecommissioned;

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();

    if (IsMainUiDisabled)
    {
      return;
    }

    if (RendererInfo.IsInteractive)
    {
      var authState = await AuthState.GetAuthenticationStateAsync();
      if (TryConfineDeviceSessionGuest(authState.User))
      {
        return;
      }

      AuthState.AuthenticationStateChanged += HandleAuthenticationStateChanged;

      if (IsAuthenticated)
      {
        await HubConnector.Value.Connect<IViewerHub>(AppConstants.ViewerHubPath);
      }

      _isServerDecommissioned = PersistentState.Value.IsDecommissioned;
    }
  }

  // A no-login device-access guest (logon-token invite) must never sit on a main-app page. The server
  // middleware blocks full loads; this catches client-side navigation (e.g. a "back to dashboard" link)
  // and sends the guest to their device-access view. Normal users are unaffected.
  private bool TryConfineDeviceSessionGuest(System.Security.Claims.ClaimsPrincipal user)
  {
    if (!user.IsDeviceSessionGuest())
    {
      return false;
    }

    var scope = user.GetDeviceSessionScopeId();
    var target = Guid.TryParse(scope, out _)
      ? $"/device-access/remote-control?deviceId={scope}"
      : "/device-access";
    NavManager.NavigateTo(target, replace: true);
    return true;
  }

  private async void HandleAuthenticationStateChanged(Task<AuthenticationState> taskState)
  {
    try
    {
      if (!RendererInfo.IsInteractive)
      {
        return;
      }

      var state = await taskState;
      if (TryConfineDeviceSessionGuest(state.User))
      {
        return;
      }

      IsAuthenticated = state.User.Identity?.IsAuthenticated ?? false;
      await InvokeAsync(StateHasChanged);

      if (IsAuthenticated)
      {
        await HubConnector.Value.Connect<IViewerHub>(AppConstants.ViewerHubPath);
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Error while handling authentication state change.");
      Snackbar.Value.Add("Authentication state change error", Severity.Error);
    }
  }

  public override async ValueTask DisposeAsync()
  {
    AuthState.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
    await base.DisposeAsync();
  }

}