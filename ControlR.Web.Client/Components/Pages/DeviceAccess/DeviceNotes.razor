<MudText Typo="Typo.h6" Class="mt-4" GutterBottom>Notes</MudText>

@if (_isLoaded)
{
  <MudTextField T="string" @bind-Value="_notes" Immediate Lines="5" Variant="Variant.Outlined"
                ReadOnly="@(!CanEdit)" MaxLength="DtoLimits.DeviceNotesMaxLength" Class="mb-2" />

  @if (CanEdit)
  {
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_isSaving" OnClick="Save">Save Notes</MudButton>
  }
}

@code {
  private bool _isLoaded;
  private bool _isSaving;
  private string _notes = string.Empty;

  [Parameter, EditorRequired]
  public required bool CanEdit { get; set; }
  [Inject]
  public required IControlrApi ControlrApi { get; init; }
  [Parameter, EditorRequired]
  public required Guid DeviceId { get; set; }
  [Inject]
  public required ISnackbar Snackbar { get; init; }
  [Parameter, EditorRequired]
  public required Guid TenantId { get; set; }

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();

    var result = await ControlrApi.V1.DeviceNotes.GetDeviceNotes(DeviceId, TenantId);
    if (result.IsSuccess)
    {
      _notes = result.Value.Notes;
      _isLoaded = true;
    }
  }

  private async Task Save()
  {
    _isSaving = true;

    var result = await ControlrApi.V1.DeviceNotes.UpdateDeviceNotes(
      DeviceId,
      TenantId,
      new ControlR.Libraries.Api.Contracts.Dtos.ServerApi.V1.DeviceNotesDto(_notes ?? string.Empty));

    Snackbar.Add(
      result.IsSuccess ? "Notes saved" : $"Failed to save the notes: {result.Reason}",
      result.IsSuccess ? Severity.Success : Severity.Error);

    _isSaving = false;
  }
}
