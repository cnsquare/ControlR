@using ControlR.Web.Client.Components.Layout.DeviceAccess
@layout DeviceAccessLayout
@attribute [Route(ClientRoutes.DeviceAccess)]
@attribute [Authorize]

<div class="pa-4">
  @if (DeviceAccessState.IsDeviceLoaded)
  {
    <DeviceOverviewGrid Device="DeviceAccessState.CurrentDevice" />
    <DeviceNotes DeviceId="DeviceId"
                 TenantId="DeviceAccessState.CurrentDevice.TenantId"
                 CanEdit="@(DeviceAccessPermissionsState.Permissions?.CanEditNotes == true)" />
  }
</div>