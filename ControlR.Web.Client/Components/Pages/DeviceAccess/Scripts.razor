@layout DeviceAccessLayout
@attribute [Route(ClientRoutes.DeviceAccessScripts)]
@attribute [Authorize]
@using ControlR.Web.Client.Components.Layout.DeviceAccess

<div class="pa-4">
  <MudText Typo="Typo.h5" GutterBottom>Run Script</MudText>

  <MudAlert Severity="Severity.Warning" Dense Class="mb-4">
    Scripts run on this device with the agent's privileges, which is normally SYSTEM or root.
  </MudAlert>

  <div class="d-flex flex-wrap gap-4 mb-4">
    <MudSelect T="ScriptShell" Label="Shell" @bind-Value="_shell" Disabled="_isRunning" Variant="Variant.Outlined" Class="script-option">
      @foreach (var shell in AvailableShells)
      {
        <MudSelectItem T="ScriptShell" Value="@shell">@ScriptShellOptions.GetDisplayName(shell)</MudSelectItem>
      }
    </MudSelect>
    <MudNumericField T="int" Label="Timeout (seconds)" @bind-Value="_timeoutSeconds" Disabled="_isRunning"
                     Min="ScriptLimits.MinTimeoutSeconds" Max="ScriptLimits.MaxTimeoutSeconds"
                     Variant="Variant.Outlined" Class="script-option" />
  </div>

  @if (_savedScripts.Length > 0)
  {
    <MudSelect T="Guid?" Label="Load a saved script" Value="_selectedScriptId" Disabled="_isRunning"
               ValueChanged="@((Guid? id) => LoadSavedScript(id))" Variant="Variant.Outlined" Class="mb-4">
      @foreach (var script in _savedScripts)
      {
        <MudSelectItem T="Guid?" Value="@script.Id">@script.Name</MudSelectItem>
      }
    </MudSelect>
  }

  <MudTextField T="string" Label="Script" @bind-Value="_content" Immediate Disabled="_isRunning"
                Lines="12" Variant="Variant.Outlined" MaxLength="ScriptLimits.MaxContentLength"
                Class="script-editor mb-4" spellcheck="false" />

  <MudCheckBox T="bool" @bind-Value="_runOnNextConnect" Disabled="_isRunning" Class="mb-2"
               Label="If this device is offline, run this when it next connects" />

  <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
             Disabled="@(!CanRun)" OnClick="RunScript">
    @(_isRunning ? "Running" : "Run")
  </MudButton>

  @if (_result is { } result)
  {
    <MudDivider Class="my-4" />

    <div class="d-flex align-center gap-2 mb-2">
      <MudChip T="string" Color="@ScriptShellOptions.GetStatusColor(result.Status)" Size="Size.Small">@result.Status</MudChip>
      @if (result.ExitCode is { } exitCode)
      {
        <MudText Typo="Typo.body2">Exit code @exitCode</MudText>
      }
    </div>

    @if (result.Status == ScriptResultStatus.Queued)
    {
      <MudAlert Severity="Severity.Info" Dense Class="mb-2">
        This will run when the device next connects, if that is within 7 days. You can cancel it in History.
      </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(result.FailureReason))
    {
      <MudAlert Severity="Severity.Error" Dense Class="mb-2">@result.FailureReason</MudAlert>
    }

    @if (result.OutputTruncated)
    {
      <MudAlert Severity="Severity.Info" Dense Class="mb-2">The output was too long and has been cut off.</MudAlert>
    }

    @if (!string.IsNullOrEmpty(result.StandardOutput))
    {
      <MudText Typo="Typo.subtitle2">Output</MudText>
      <pre class="script-output">@result.StandardOutput</pre>
    }

    @if (!string.IsNullOrEmpty(result.StandardError))
    {
      <MudText Typo="Typo.subtitle2">Errors</MudText>
      <pre class="script-output script-output-error">@result.StandardError</pre>
    }
  }

  <MudDivider Class="my-4" />

  <MudText Typo="Typo.h6" GutterBottom>History</MudText>

  @if (_history.Length == 0)
  {
    <MudText Typo="Typo.body2">No scripts have been run on this device.</MudText>
  }
  else
  {
    <MudSimpleTable Dense Hover>
      <thead>
        <tr>
          <th>Time</th>
          <th>Status</th>
          <th>Run by</th>
          <th>Script</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var item in _history)
        {
          <tr @key="item.ScriptRunId">
            <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
            <td>
              <MudChip T="string" Color="@ScriptShellOptions.GetStatusColor(item.Status)" Size="Size.Small">@item.Status</MudChip>
            </td>
            <td>@item.InitiatedBy</td>
            <td class="script-preview">@item.ContentPreview</td>
            <td>
              <MudButton Size="Size.Small" Disabled="_isRunning" OnClick="@(() => ShowRun(item.ScriptRunId))">View</MudButton>
              @if (item.Status == ScriptResultStatus.Queued)
              {
                <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => CancelQueued(item.ScriptRunId))">Cancel</MudButton>
              }
            </td>
          </tr>
        }
      </tbody>
    </MudSimpleTable>
    <MudButton Variant="Variant.Outlined" Class="mt-2" OnClick="ExportHistory">Export CSV</MudButton>
  }
</div>
