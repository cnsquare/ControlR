@attribute [Route(ClientRoutes.TenantSettings)]
@using ControlR.Libraries.Api.Contracts.Settings
@attribute [Authorize(Policy = PolicyNames.RequireTenantSettingsRead)]

@inject AuthenticationStateProvider AuthState
@inject ITenantSettingsProvider TenantSettingsProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>
  Tenant Settings
</PageTitle>

<PrimaryTitle>
  Tenant Settings
</PrimaryTitle>

<div class="mt-10">
  <MudText Typo="Typo.h6" Color="Color.Primary" GutterBottom>
    Show Notification to User
  </MudText>
  <MudText Typo="Typo.body2" Class="mb-3">
    Controls whether users receive notifications when remote control sessions start.
  </MudText>
  
  <MudRadioGroup T="bool?" Value="_notifyUser" ValueChanged="SetNotifyUser">
    <MudRadio T="bool?" Value="@((bool?)null)" Color="Color.Primary" Disabled="!_canWrite">
      Use individual account setting
    </MudRadio>
    <MudRadio T="bool?" Value="@((bool?)true)" Color="Color.Primary" Disabled="!_canWrite">
      Always notify users
    </MudRadio>
    <MudRadio T="bool?" Value="@((bool?)false)" Color="Color.Primary" Disabled="!_canWrite">
      Never notify users
    </MudRadio>
  </MudRadioGroup>

  <div class="mt-10">
    <MudText Typo="Typo.h6" Color="Color.Primary" GutterBottom>
      Instance ID
    </MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
      If enabled, the instance ID will be used for agent installations, allowing multiple agents from different servers to be installed on the same machine.
    </MudText>

    <MudCheckBox T="bool"
                 @bind-Value:get="_appendInstanceId"
                 @bind-Value:set="SetAppendInstanceId"
                 Disabled="!_canWrite"
                 Label="Append instance ID to agent installations" />

    <MudTextField T="string"
                  @bind-Value="_instanceId"
                  Immediate="true"
                  Validation="@(new Func<string?, string?>(InstanceIdValidator))"
                  OnBlur="SaveInstanceIdOnBlur"
                  Disabled="!_canWrite"
                  Label="Instance ID"
                  Placeholder="If empty, defaults to this server's hostname."
                  Class="mt-3" />
  </div>

  <div class="mt-10">
    <MudText Typo="Typo.h6" Color="Color.Primary" GutterBottom>
      Agent Name
    </MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
      The name shown for the agent in Windows Services and Installed Apps. Devices pick up a change
      within a few minutes. Leave it empty for the default. Windows only.
    </MudText>

    <MudTextField T="string"
                  @bind-Value="_agentDisplayName"
                  Immediate="true"
                  Validation="@(new Func<string?, string?>(TenantSettingDefinitions.GetAgentDisplayNameError))"
                  OnBlur="SaveAgentDisplayNameOnBlur"
                  Disabled="!_canWrite"
                  MaxLength="60"
                  Label="Agent Name" />
  </div>

  <div class="mt-10">
    <MudText Typo="Typo.h6" Color="Color.Primary" GutterBottom>
      Fleet Enrollment Secret
    </MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
      Agents use this secret to re-create their own device records if this server's database is ever
      lost and rebuilt. Rotating it issues a fresh secret; agents adopt the new one within a few
      minutes, on their next heartbeat. Rotate it if you suspect the current secret has been exposed.
    </MudText>

    <MudButton Variant="Variant.Outlined"
               Color="Color.Warning"
               StartIcon="@Icons.Material.Filled.Autorenew"
               Disabled="!_canWrite || _isRotatingSecret"
               OnClick="RotateFleetSecret">
      Rotate Fleet Secret
    </MudButton>
  </div>
</div>

@code {
  private string? _agentDisplayName;
  private bool _appendInstanceId = true;
  private bool _canWrite;
  private string? _instanceId;
  private bool _isRotatingSecret;
  private bool? _notifyUser;

  protected override async Task OnInitializedAsync()
  {
    var state = await AuthState.GetAuthenticationStateAsync();
    _canWrite = state.User.HasClientPolicy(PolicyNames.RequireTenantSettingsWrite);
    var settings = await TenantSettingsProvider.GetSettings();
    _notifyUser = settings.NotifyUserOnSessionStart;
    _appendInstanceId = settings.AppendInstanceId ?? false;
    _instanceId = settings.InstanceId;
    _agentDisplayName = settings.AgentDisplayName;
    await base.OnInitializedAsync();
  }

  private static string? InstanceIdValidator(string? value)
  {
    var trimmedValue = value?.Trim();

    if (string.IsNullOrWhiteSpace(trimmedValue))
    {
      return null;
    }

    return SharedValidators.ValidateInstanceId(trimmedValue);
  }

  private async Task SaveInstanceIdOnBlur(FocusEventArgs _)
  {
    await SaveInstanceId();
  }

  private async Task SaveInstanceId()
  {
    var validationMessage = InstanceIdValidator(_instanceId);
    if (validationMessage is not null)
    {
      Snackbar.Add(validationMessage, Severity.Error);
      return;
    }

    _instanceId = string.IsNullOrWhiteSpace(_instanceId)
      ? null
      : _instanceId.Trim();

    if (await TenantSettingsProvider.SetInstanceId(_instanceId))
    {
      Snackbar.Add("Setting updated", Severity.Success);
    }
  }

  private async Task SaveAgentDisplayNameOnBlur()
  {
    if (TenantSettingDefinitions.GetAgentDisplayNameError(_agentDisplayName) is { } error)
    {
      Snackbar.Add(error, Severity.Error);
      return;
    }

    if (await TenantSettingsProvider.SetAgentDisplayName(_agentDisplayName))
    {
      Snackbar.Add("Setting updated", Severity.Success);
    }
  }

  private async Task RotateFleetSecret()
  {
    var result = await DialogService.ShowMessageBoxAsync(
      "Rotate Fleet Secret",
      "Issue a new fleet enrollment secret? Agents adopt it on their next heartbeat. " +
      "The previous secret stops working once an agent has adopted the new one.",
      yesText: "Rotate",
      noText: "Cancel");

    if (!result.HasValue || !result.Value)
    {
      return;
    }

    _isRotatingSecret = true;
    try
    {
      if (await TenantSettingsProvider.RotateFleetSecret())
      {
        Snackbar.Add("Fleet secret rotated", Severity.Success);
      }
    }
    finally
    {
      _isRotatingSecret = false;
    }
  }

  private async Task SetAppendInstanceId(bool value)
  {
    if (await TenantSettingsProvider.SetAppendInstanceId(value))
    {
      _appendInstanceId = value;
      Snackbar.Add("Setting updated", Severity.Success);
    }
  }

  private async Task SetNotifyUser(bool? value)
  {
    if (await TenantSettingsProvider.SetNotifyUserOnSessionStart(value))
    {
      _notifyUser = value;
      Snackbar.Add("Setting updated", Severity.Success);
    }
  }
}