@inherits DisposableComponent

<div class="d-flex flex-column gap-3">
  <div>
    <MudTooltip Text="Show metrics overlay">
      <MudSwitch Value="RemoteControlState.IsMetricsEnabled"
                 ValueChanged="@((bool value) => HandleMetricsToggled(value))"
                 Color="Color.Secondary"
                 Label="Metrics"
                 ThumbIcon="@(Icons.Material.Filled.QueryStats)" />
    </MudTooltip>
  </div>

  @if (IsWindows)
  {
    <div>
      <MudTooltip Text="Use DirectX capture for better performance">
        <MudSwitch T="bool"
                   Value="RemoteControlState.EnableDirectX"
                   ValueChanged="@(HandleDirectXChanged)"
                   Color="Color.Secondary"
                   Label="DirectX"
                   ThumbIcon="@Icons.Material.Filled.Dashboard" />
      </MudTooltip>
    </div>
  }

  @* The invite creates a no-login link to a device. A Flash Assist session has no device record
     (and the relay is single-viewer), so the button cannot work there — show it only for a loaded
     device session. *@
  @if (DeviceState.IsDeviceLoaded)
  {
    <MudDivider />
    <div>
      <MudTooltip Text="Create a no-login link to share this remote session with another technician">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Share"
                   OnClick="ShareSession">
          Share
        </MudButton>
      </MudTooltip>
    </div>
  }
</div>
