# EnkrOma deployment secrets and settings.
# Copy to ".env" in this folder and fill in. Never commit the real .env.
#   cp .env.example .env

# ---- Image (built by ./build-image.sh) ----
ENKROMA_IMAGE=enkroma/controlr:1.0.0

# ---- REQUIRED: database credentials (change these) ----
ControlR_POSTGRES_USER=enkroma
ControlR_POSTGRES_PASSWORD=change-me-to-a-strong-random-password

# ---- REQUIRED: the public URL agents and browsers reach this server at ----
# Include scheme (and port if non-standard). No trailing slash, path, or query.
ControlR_AppOptions__PublicBaseUrl=https://control.enkroma.com

# ---- REQUIRED: Aspire telemetry dashboard browser token (long random) ----
ControlR_ASPIRE_BROWSER_TOKEN=change-me-to-a-very-long-random-token

# ---- Reverse proxy ----
# Set true if TLS is terminated at Cloudflare in front of this server.
ControlR_AppOptions__EnableCloudflareProxySupport=false
# Restrict accepted hostnames (semicolon-separated, no ports). Leave as * to accept all.
ControlR_AllowedHosts=*

# ---- First admin (optional) ----
# Uncomment both to auto-create an admin on first startup (only when no users exist).
# Otherwise, register the first user in the UI; they become admin automatically.
#ControlR_Bootstrap__AdminEmail=admin@enkroma.com
#ControlR_Bootstrap__AdminPassword=change-me-now-strong

# ---- Email (needed if RequireUserEmailConfirmation stays true) ----
# To skip email entirely for a small/internal deployment, set:
#   ControlR_AppOptions__RequireUserEmailConfirmation=false
ControlR_AppOptions__RequireUserEmailConfirmation=true
ControlR_AppOptions__DisableEmailSending=false
ControlR_AppOptions__SmtpDisplayName=EnkrOma
ControlR_AppOptions__SmtpEmail=
ControlR_AppOptions__SmtpHost=
ControlR_AppOptions__SmtpPort=587
ControlR_AppOptions__SmtpUserName=
ControlR_AppOptions__SmtpPassword=

# ---- Telemetry dashboard public URL (where you expose Aspire, if at all) ----
ControlR_AspireDashboard__PublicWebUrl=http://localhost:18888
ControlR_Logging__LogLevel__Default=Information
